-  r->data = body + 1; r->len = (int64_t)len; r->cap = (int64_t)len; r->binary = 0;
+  r->data = body + 1; r->len = (int64_t)len; r->cap = (int64_t)len; r->binary = 0; r->temporarily_locked = 0;
