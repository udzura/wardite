  "runner_source": "from pathlib import Path\nimport hashlib,json,statistics,subprocess,time\nbase=Path(__file__).resolve().parent\nroot=base.parents[2]\nsetup=json.loads((base/'setup.json').read_text())\nwasm=root/'build/benchmark/i32_mix.wasm'\nseed=123456789\n\ndef reference(rounds):\n    x=seed\n    for _ in range(rounds):\n        x ^= x//8192\n        x=(x*1664525+1013904223)%(2**32)\n        x=(x^(x*128))%(2**32)\n    return x\n\ndef invoke(row,rounds,expected):\n    command=[str(base/('wardite-'+row['compiler'])),'--new-engine','--no-wasi']\n    if row['disabled']:command+=['--mir-disable',row['disabled']]\n    command+=['--invoke',row['export'],'--',str(wasm),str(rounds),str(seed)]\n    started=time.monotonic()\n    result=subprocess.run(command,capture_output=True,text=True,check=True)\n    elapsed=time.monotonic()-started\n    signed=expected if expected<2**31 else expected-2**32\n    assert result.stdout=='' and result.stderr==f'return value: I32({signed})\\n',(command,result.stdout,result.stderr)\n    return elapsed\n\nrows=[dict(compiler=compiler,export=export,disabled=disabled) for compiler in ['unpatched','patched'] for export,disabled in [('inline_mix',''),('call_mix',''),('call_mix','inline')]]\nreport=dict(setup=setup,seed=seed,runs=7,warmups=2,fixture_sha256=hashlib.sha256(wasm.read_bytes()).hexdigest(),units='raw samples seconds; summaries milliseconds; full CLI process times',runner_source=Path(__file__).read_text(),measurements=[])\nfor n in [100000,5000000]:\n    expected=reference(n)\n    current=[dict(**r,samples=[]) for r in rows]\n    for iteration in range(9):\n        order=current[iteration%len(current):]+current[:iteration%len(current)]\n        if iteration%2:order.reverse()\n        for row in order:\n            elapsed=invoke(row,n,expected)\n            if iteration>=2:row['samples'].append(elapsed)\n        print(n,'warmup' if iteration<2 else 'sample',iteration+1 if iteration<2 else iteration-1,flush=True)\n    for row in current:\n        values=[x*1000 for x in row['samples']]\n        row['statistics_ms']=dict(mean=statistics.mean(values),sd=statistics.stdev(values),min=min(values),max=max(values))\n        print(n,row['compiler'],row['export'],row['disabled'] or 'inline-on',row['statistics_ms'],flush=True)\n    report['measurements'].append(dict(rounds=n,checksum=expected,results=current))\n    (base/'comparison.json').write_text(json.dumps(report,indent=2)+'\\n')\n",
