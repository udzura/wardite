  "patches": {
    "lib/wardite/efflorescence/ir.rb": "diff --git a/lib/wardite/efflorescence/ir.rb b/lib/wardite/efflorescence/ir.rb\nindex 5d9d96c..5bc87b9 100644\n--- a/lib/wardite/efflorescence/ir.rb\n+++ b/lib/wardite/efflorescence/ir.rb\n@@ -232,18 +232,28 @@ module Wardite\n         @pool_index = callee.index\n       end\n \n-      # Keep the generic argument loop out of the interpreter's live locals.\n-      # The common single-argument path copies directly from the CALL operand.\n+      # Keep multi-argument transfer out of the interpreter's live locals.\n+      # Small arities copy directly; only larger calls loop.\n       # @rbs target: Array[Integer]\n       # @rbs source: Array[Integer]\n       # @rbs return: void\n       def copy_arguments(target, source)\n-        argument = 0\n         count = @arguments.size\n-        while argument < count\n-          target[argument] = source[@arguments.fetch(argument)]\n-          argument += 1\n+        return if count == 0\n+        if count <= 3\n+          target[0] = source[@arguments.fetch(0)]\n+          target[1] = source[@arguments.fetch(1)] if count >= 2\n+          target[2] = source[@arguments.fetch(2)] if count == 3\n+        else\n+          argument = 0\n+          while argument < count\n+            target[argument] = source[@arguments.fetch(argument)]\n+            argument += 1\n+          end\n         end\n+        # The transfer has no result. Avoid boxing the last copied value in\n+        # Spinel's generated C when returning from a specialized transfer.\n+        nil\n       end\n     end\n \n",
